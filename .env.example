# Smart Chalkboard — local developer configuration (DO NOT COMMIT REAL KEYS).
# Copy to `.env` and fill in values. `.env` is gitignored; this file holds placeholders only.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Set to 1 to reveal the developer transcript input box (hidden by default).
SMARTBOARD_DEV_INPUT=

WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu